{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "installCommand": "npm ci --ignore-scripts",
    "rewrites": [
        {
            "source": "/api/v1/:path*",
            "destination": "https://tvchbmen-api.vercel.app/api/v1/:path*"
        },
        {
            "source": "/health",
            "destination": "https://tvchbmen-api.vercel.app/health"
        },
        {
            "source": "/swagger/:path*",
            "destination": "https://tvchbmen-api.vercel.app/swagger/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
