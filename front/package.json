        "react-transition-group": "^4.4.5",
        "redux": "^5.0.1"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@eslint/js": "^9.31.0",
        "@storybook/react-vite": "^10.5.7",
        "@types/node": "^26.1.2",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@types/react-transition-group": "^4.4.12",
        "@vitejs/plugin-react": "^4.7.0",
        "eslint": "^9.31.0",
